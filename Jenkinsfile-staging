pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo '================================='
                echo 'Checking out JioBP source code'
                echo '================================='

                checkout scm

                echo 'Source code checkout completed.'
            }
        }

        stage('Build JioBP') {
            steps {

                echo '================================='
                echo 'Building JioBP'
                echo '================================='

                withCredentials([
                    file(
                        credentialsId: 'JioBP-Staging',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "Node version:"
                        node -v

                        echo "NPM version:"
                        npm -v

                        echo "================================="
                        echo "Preparing staging environment"
                        echo "================================="

                        cp "$ENV_FILE" .env

                        echo "Staging environment prepared."

                        echo "================================="
                        echo "Installing dependencies"
                        echo "================================="

                        npm install

                        echo "================================="
                        echo "Building Next.js application"
                        echo "================================="

                        npm run build

                        echo "================================="
                        echo "Build completed successfully"
                        echo "================================="

                        echo "Checking standalone output..."

                        if [ -f ".next/standalone/server.js" ]; then
                            echo "Standalone server.js found."
                        else
                            echo "ERROR: .next/standalone/server.js not found."
                            exit 1
                        fi

                        echo "Build verification completed."
                    '''
                }
            }
        }

        stage('Test Jenkins to Staging') {
            steps {

                echo '================================='
                echo 'Testing Jenkins -> Staging SSH'
                echo '================================='

                sshagent(credentials: ['staging-deploy-key']) {

                    sh '''
                        ssh -o StrictHostKeyChecking=yes deploy@3.111.24.72 \
                        "echo 'SSH SUCCESSFUL'; \
                        echo 'User:' \\$(whoami); \
                        echo 'Hostname:' \\$(hostname); \
                        echo 'Directory:' \\$(pwd)"
                    '''
                }
            }
        }

        stage('Test SCP to Staging') {
            steps {

                echo '================================='
                echo 'Testing Jenkins -> Staging SCP'
                echo '================================='

                sh '''
                    echo "Jenkins staging deployment test" > jenkins-staging-test.txt
                '''

                sshagent(credentials: ['staging-deploy-key']) {

                    sh '''
                        scp -o StrictHostKeyChecking=yes \
                        jenkins-staging-test.txt \
                        deploy@3.111.24.72:/home/ubuntu/app/
                    '''
                }
            }
        }

        stage('Verify Staging') {
            steps {

                echo '================================='
                echo 'Verifying Staging Server'
                echo '================================='

                sshagent(credentials: ['staging-deploy-key']) {

                    sh '''
                        ssh -o StrictHostKeyChecking=yes deploy@3.111.24.72 \
                        "echo 'File on staging:'; \
                        cat /home/ubuntu/app/jenkins-staging-test.txt"
                    '''
                }
            }
        }
    }

    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            sh '''
                rm -f .env
                rm -f jenkins-staging-test.txt
            '''
        }

        success {

            echo '''
=================================
JioBP staging pipeline SUCCESSFUL
=================================
'''
        }

        failure {

            echo '''
=================================
JioBP staging pipeline FAILED
=================================
Check the failed stage above.
=================================
'''
        }
    }
}