pipeline {
    agent any

    tools {
        nodejs "nodejs-23"
    }

    environment {

        /*
         * ============================================================
         * STAGING CONFIGURATION
         * Change these values for each project.
         * ============================================================
         */

        APP_NAME        = "jiobp"
        PM2_NAME        = "jiobp-staging"
        DEPLOY_PATH     = "/home/ubuntu/app/jiobp"
        DEPLOY_USER     = "ubuntu"
        STAGING_HOST    = "3.111.24.72"
        PORT            = "3000"

        /*
         * Jenkins Credentials
         *
         * Create this credential in:
         * Jenkins -> Manage Jenkins -> Credentials
         *
         * Type: Secret file
         * ID: jiobp-staging
         *
         * The file should contain the staging .env.
         */
        ENV_CREDENTIAL_ID = "jiobp-staging"

        /*
         * Node.js binaries
         */
        NODE_BIN = "/home/ubuntu/.nvm/versions/node/v23.11.1/bin/node"
        NPM_BIN  = "/home/ubuntu/.nvm/versions/node/v23.11.1/bin/npm"
        PM2_BIN  = "/home/ubuntu/.nvm/versions/node/v23.11.1/bin/pm2"

        /*
         * Next.js standalone server
         */
        STANDALONE_SERVER = ".next/standalone/server.js"
    }

    stages {

        /*
         * ============================================================
         * 1. CHECKOUT
         * ============================================================
         */
        stage("Checkout") {
            steps {

                echo "================================="
                echo "Checking out source code"
                echo "================================="

                deleteDir()

                checkout scm

                echo "Source code checkout completed."
            }
        }


        /*
         * ============================================================
         * 2. PREPARE ENVIRONMENT
         * ============================================================
         */
        stage("Prepare Environment") {
            steps {

                echo "================================="
                echo "Preparing staging environment"
                echo "================================="

                withCredentials([
                    file(
                        credentialsId: "${ENV_CREDENTIAL_ID}",
                        variable: "SECRET_ENV_FILE"
                    )
                ]) {

                    sh '''
                        set -e

                        echo "Copying staging environment file..."

                        cp "${SECRET_ENV_FILE}" .env

                        chmod 600 .env

                        echo "Staging environment prepared."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 3. INSTALL DEPENDENCIES
         * ============================================================
         */
        stage("Install Dependencies") {
            steps {

                echo "================================="
                echo "Installing dependencies"
                echo "================================="

                sh '''
                    set -e

                    echo "Node version:"
                    node -v

                    echo "NPM version:"
                    npm -v

                    echo "Installing dependencies..."

                    npm install

                    echo "Dependencies installed successfully."
                '''
            }
        }


        /*
         * ============================================================
         * 4. BUILD
         * ============================================================
         */
        stage("Build") {
            steps {

                echo "================================="
                echo "Building Next.js application"
                echo "================================="

                sh '''
                    set -e

                    echo "Starting Next.js production build..."

                    npm run build

                    echo "Next.js build completed."
                '''
            }
        }


        /*
         * ============================================================
         * 5. VERIFY BUILD
         * ============================================================
         */
        stage("Verify Build") {
            steps {

                echo "================================="
                echo "Verifying standalone build"
                echo "================================="

                sh '''
                    set -e

                    echo "Checking standalone server..."

                    if [ ! -f "${STANDALONE_SERVER}" ]; then
                        echo "ERROR: Standalone server.js not found!"
                        echo "Expected:"
                        echo "${STANDALONE_SERVER}"
                        exit 1
                    fi

                    echo "Standalone server found."

                    echo "Checking .next/standalone..."

                    ls -lah .next/standalone

                    echo "Checking .next/static..."

                    if [ -d ".next/static" ]; then
                        ls -lah .next/static
                    else
                        echo "WARNING: .next/static not found."
                    fi

                    echo "Build verification successful."
                '''
            }
        }


        /*
         * ============================================================
         * 6. TEST SSH
         * ============================================================
         */
        stage("Test SSH") {
            steps {

                echo "================================="
                echo "Testing Jenkins -> Staging SSH"
                echo "================================="

                sshagent(credentials: ['deploy']) {

                    sh '''
                        set -e

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "echo SSH SUCCESSFUL && \
                         echo User: \\$(whoami) && \
                         echo Hostname: \\$(hostname)"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 7. DEPLOY
         * ============================================================
         */
        stage("Deploy to Staging") {
            steps {

                echo "================================="
                echo "Deploying application to staging"
                echo "================================="

                withCredentials([
                    file(
                        credentialsId: "${ENV_CREDENTIAL_ID}",
                        variable: "SECRET_ENV_FILE"
                    )
                ]) {

                    sshagent(credentials: ['deploy']) {

                        sh '''
                            set -e

                            echo "Preparing deployment package..."

                            rm -rf deploy-package

                            mkdir -p deploy-package

                            /*
                             * Copy Next.js standalone build.
                             */
                            cp -a .next/standalone/. deploy-package/

                            /*
                             * Copy static files.
                             */
                            mkdir -p deploy-package/.next

                            cp -a .next/static deploy-package/.next/

                            /*
                             * Copy public directory.
                             */
                            if [ -d "public" ]; then
                                cp -a public deploy-package/
                            fi

                            /*
                             * Copy ecosystem configuration if present.
                             */
                            if [ -f "ecosystem.config.js" ]; then
                                cp ecosystem.config.js deploy-package/
                            fi

                            /*
                             * Copy staging environment.
                             */
                            cp "${SECRET_ENV_FILE}" deploy-package/.env

                            echo "Deployment package created."

                            echo "Package contents:"
                            find deploy-package -maxdepth 3 -type f | sort
                        '''


                        echo "================================="
                        echo "Copying files to staging server"
                        echo "================================="

                        sh '''
                            set -e

                            /*
                             * Create deployment directory.
                             */
                            ssh \
                            -o StrictHostKeyChecking=yes \
                            ${DEPLOY_USER}@${STAGING_HOST} \
                            "mkdir -p ${DEPLOY_PATH}"
                        '''

                        /*
                         * Copy deployment package.
                         */
                        sh '''
                            set -e

                            scp \
                            -r \
                            -o StrictHostKeyChecking=yes \
                            deploy-package/. \
                            ${DEPLOY_USER}@${STAGING_HOST}:${DEPLOY_PATH}/
                        '''


                        /*
                         * Fix ownership.
                         */
                        sh '''
                            set -e

                            ssh \
                            -o StrictHostKeyChecking=yes \
                            ${DEPLOY_USER}@${STAGING_HOST} \
                            "sudo chown -R ${DEPLOY_USER}:${DEPLOY_USER} ${DEPLOY_PATH}"
                        '''

                        echo "Files copied successfully."
                    }
                }
            }
        }


        /*
         * ============================================================
         * 8. VERIFY DEPLOYMENT FILES
         * ============================================================
         */
        stage("Verify Deployment") {
            steps {

                echo "================================="
                echo "Verifying deployment files"
                echo "================================="

                sshagent(credentials: ['deploy']) {

                    sh '''
                        set -e

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "
                        echo 'Deployment directory:';
                        ls -lah ${DEPLOY_PATH};

                        echo '';
                        echo 'Next.js directory:';
                        ls -lah ${DEPLOY_PATH}/.next;

                        echo '';
                        echo 'Standalone server:';
                        ls -lh ${DEPLOY_PATH}/server.js;

                        echo '';
                        echo 'Environment file:';
                        ls -lh ${DEPLOY_PATH}/.env;
                        "
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 9. CREATE / UPDATE PM2 CONFIG
         * ============================================================
         */
        stage("Configure PM2") {
            steps {

                echo "================================="
                echo "Configuring PM2"
                echo "================================="

                sshagent(credentials: ['deploy']) {

                    sh '''
                        set -e

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "
                        cd ${DEPLOY_PATH}

                        cat > ecosystem.config.js <<'EOF'
module.exports = {
    apps: [{
        name: '${PM2_NAME}',
        script: 'server.js',
        cwd: '${DEPLOY_PATH}',
        exec_mode: 'fork',
        instances: 1,
        autorestart: true,
        watch: false,
        max_memory_restart: '500M',

        env: {
            NODE_ENV: 'production',
            PORT: ${PORT}
        }
    }]
};
EOF

                        echo 'PM2 configuration created:'
                        cat ecosystem.config.js
                        "
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 10. START / RESTART PM2
         * ============================================================
         */
        stage("Start Application") {
            steps {

                echo "================================="
                echo "Starting JioBP with PM2"
                echo "================================="

                sshagent(credentials: ['deploy']) {

                    sh '''
                        set -e

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "
                        cd ${DEPLOY_PATH}

                        echo 'Stopping old PM2 process if present...'

                        ${PM2_BIN} delete ${PM2_NAME} || true

                        echo 'Starting application...'

                        ${PM2_BIN} start ecosystem.config.js --update-env

                        echo 'Saving PM2 process list...'

                        ${PM2_BIN} save

                        echo 'PM2 status:'

                        ${PM2_BIN} status
                        "
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 11. HEALTH CHECK
         * ============================================================
         */
        stage("Health Check") {
            steps {

                echo "================================="
                echo "Checking application health"
                echo "================================="

                sshagent(credentials: ['deploy']) {

                    sh '''
                        set -e

                        echo "Waiting for application to start..."

                        sleep 10

                        echo "Checking PM2 status..."

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "${PM2_BIN} status ${PM2_NAME}"

                        echo "Checking HTTP endpoint..."

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "curl -f http://127.0.0.1:${PORT}/"

                        echo ""
                        echo "================================="
                        echo "APPLICATION HEALTH CHECK PASSED"
                        echo "================================="
                    '''
                }
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */
    post {

        success {

            echo ""
            echo "================================="
            echo "JioBP STAGING DEPLOYMENT SUCCESSFUL"
            echo "================================="
            echo ""
            echo "Application:"
            echo "${PM2_NAME}"
            echo ""
            echo "Port:"
            echo "${PORT}"
            echo ""
            echo "Server:"
            echo "${STAGING_HOST}"
            echo ""
        }

        failure {

            echo ""
            echo "================================="
            echo "JioBP STAGING DEPLOYMENT FAILED"
            echo "================================="
            echo ""
            echo "Please check the failed stage above."
            echo ""
        }

        always {

            echo "Cleaning Jenkins workspace..."

            sh '''
                rm -rf deploy-package || true
                rm -f .env || true
            '''
        }
    }
}