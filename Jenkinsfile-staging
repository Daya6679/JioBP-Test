pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo "================================="
                echo "Checking out JioBP source code"
                echo "================================="

                checkout scm

                echo "Source code checkout completed."
            }
        }


        stage('Build JioBP') {
            steps {
                echo "================================="
                echo "Building JioBP"
                echo "================================="

                sh '''
                    echo "Node version:"
                    node -v

                    echo "NPM version:"
                    npm -v

                    echo "Installing dependencies..."
                    npm install

                    echo "Building Next.js application..."
                    npm run build

                    echo "================================="
                    echo "Build completed successfully"
                    echo "================================="

                    echo "Checking .next directory..."
                    ls -lah .next

                    echo "Checking standalone directory..."
                    ls -lah .next/standalone

                    echo "Checking server.js..."
                    ls -lah .next/standalone/server.js
                '''
            }
        }


        stage('Test Jenkins to Staging') {
            steps {

                sshagent(['staging-deploy-key']) {

                    sh '''
                        echo "================================="
                        echo "Jenkins -> Staging SSH Test"
                        echo "================================="

                        ssh -o StrictHostKeyChecking=yes \
                            deploy@3.111.24.72 \
                            "echo 'SSH SUCCESSFUL'; \
                             echo 'User:' \\$(whoami); \
                             echo 'Hostname:' \\$(hostname); \
                             echo 'Directory:' \\$(pwd)"
                    '''
                }
            }
        }


        stage('Test SCP to Staging') {
            steps {

                sh '''
                    echo "Jenkins SCP test file"
                    echo "Jenkins -> Staging SCP test" > jenkins-staging-test.txt
                '''

                sshagent(['staging-deploy-key']) {

                    sh '''
                        scp -o StrictHostKeyChecking=yes \
                            jenkins-staging-test.txt \
                            deploy@3.111.24.72:/home/ubuntu/app/
                    '''
                }
            }
        }


        stage('Verify Staging') {
            steps {

                sshagent(['staging-deploy-key']) {

                    sh '''
                        ssh -o StrictHostKeyChecking=yes \
                            deploy@3.111.24.72 \
                            "echo 'File on staging:'; \
                             cat /home/ubuntu/app/jenkins-staging-test.txt"
                    '''
                }
            }
        }
    }


    post {

        success {
            echo "================================="
            echo "JioBP staging pipeline TEST SUCCESSFUL"
            echo "================================="
        }

        failure {
            echo "================================="
            echo "JioBP staging pipeline FAILED"
            echo "Check the stage above for the error."
            echo "================================="
        }
    }
}