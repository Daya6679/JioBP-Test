pipeline {

    agent any

    tools {
        nodejs "nodejs-23"
    }

    /*
     * ============================================================
     * STAGING CONFIGURATION
     * ============================================================
     *
     * These values are project-specific.
     *
     * For another project, change these values only.
     */

    environment {

        // Application
        APP_NAME    = "jiobp"
        PM2_NAME    = "jiobp-staging"
        PORT        = "3000"

        // Staging server
        DEPLOY_USER = "ubuntu"
        STAGING_HOST = "3.111.24.72"
        DEPLOY_PATH = "/home/ubuntu/app/jiobp"

        // Jenkins credentials
        ENV_CREDENTIAL_ID = "jiobp-staging"
        SSH_CREDENTIAL_ID = "jiobp-staging-ssh"

        // Node / PM2
        PM2_BIN = "/home/ubuntu/.nvm/versions/node/v23.11.1/bin/pm2"

    }


    stages {

        /*
         * ========================================================
         * 1. CLEANUP & CHECKOUT
         * ========================================================
         */
        stage("Cleanup & Checkout") {

            steps {

                script {

                    echo "================================="
                    echo "Cleanup & Checkout"
                    echo "================================="

                    // Clean previous workspace
                    deleteDir()

                    // Checkout source code
                    checkout scm

                    echo "Source code checkout completed."
                }
            }
        }


        /*
         * ========================================================
         * 2. SYNC TO EC2
         * ========================================================
         *
         * This stage:
         * - Gets staging .env from Jenkins Credentials
         * - Installs dependencies
         * - Builds Next.js
         * - Verifies standalone build
         *
         */
        stage("Sync to EC2") {

            steps {

                echo "================================="
                echo "Preparing Staging Environment"
                echo "================================="

                withCredentials([
                    file(
                        credentialsId: "${ENV_CREDENTIAL_ID}",
                        variable: "SECRET_ENV_FILE"
                    )
                ]) {

                    sh '''
                        set -e

                        echo "Copying staging .env..."

                        cp "${SECRET_ENV_FILE}" .env

                        chmod 600 .env

                        echo "Staging .env prepared."

                        echo "================================="
                        echo "Installing dependencies"
                        echo "================================="

                        npm install

                        echo "Dependencies installed successfully."

                        echo "================================="
                        echo "Building Next.js application"
                        echo "================================="

                        npm run build

                        echo "Build completed successfully."

                        echo "================================="
                        echo "Checking standalone build"
                        echo "================================="

                        if [ ! -f ".next/standalone/server.js" ]; then
                            echo "ERROR: Next.js standalone server.js not found."
                            exit 1
                        fi

                        echo "Standalone server.js found."

                        echo "Build verification successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 3. BUILD
         * ========================================================
         *
         * Kept as one simple stage.
         *
         * This stage verifies that the production build is ready.
         *
         */
        stage("Build") {

            steps {

                echo "================================="
                echo "Verifying Production Build"
                echo "================================="

                sh '''
                    set -e

                    echo "Node version:"
                    node -v

                    echo "NPM version:"
                    npm -v

                    echo "Checking Next.js standalone output..."

                    test -f .next/standalone/server.js

                    echo "Standalone build is ready for deployment."

                    echo "Build contents:"
                    ls -lah .next/standalone
                '''
            }
        }


        /*
         * ========================================================
         * 4. DEPLOY
         * ========================================================
         *
         * This is the important part.
         *
         * We deploy:
         *
         * .next/standalone/*
         * .next/static
         * public
         * .env
         *
         * The standalone server.js becomes:
         *
         * /home/ubuntu/app/jiobp/server.js
         *
         */
        stage("Deploy") {

            steps {

                echo "================================="
                echo "Deploying to Staging Server"
                echo "================================="

                withCredentials([
                    file(
                        credentialsId: "${ENV_CREDENTIAL_ID}",
                        variable: "SECRET_ENV_FILE"
                    )
                ]) {

                    sshagent(credentials: ["${SSH_CREDENTIAL_ID}"]) {

                        sh '''
                            set -e

                            echo "Creating deployment package..."

                            rm -rf deploy-package

                            mkdir -p deploy-package

                            # Copy Next.js standalone build
                            cp -a .next/standalone/. deploy-package/

                            # Copy Next.js static files
                            mkdir -p deploy-package/.next
                            cp -a .next/static deploy-package/.next/

                            # Copy public directory
                            if [ -d "public" ]; then
                                cp -a public deploy-package/
                            fi

                            # Copy staging environment
                            cp "${SECRET_ENV_FILE}" deploy-package/.env

                            # Create PM2 configuration

                            cat > deploy-package/ecosystem.config.js <<EOF
module.exports = {
    apps: [{
        name: '${PM2_NAME}',
        script: 'server.js',
        cwd: '${DEPLOY_PATH}',
        exec_mode: 'fork',
        instances: 1,
        autorestart: true,
        watch: false,
        max_memory_restart: '500M',

        env: {
            NODE_ENV: 'production',
            PORT: ${PORT}
        }
    }]
};
EOF

                            echo "Deployment package created."

                            echo "Package structure:"

                            find deploy-package -maxdepth 3 -type f | sort


                            echo "================================="
                            echo "Creating remote deployment directory"
                            echo "================================="

                            ssh \
                            -o StrictHostKeyChecking=yes \
                            ${DEPLOY_USER}@${STAGING_HOST} \
                            "mkdir -p ${DEPLOY_PATH}"


                            echo "================================="
                            echo "Copying application to staging"
                            echo "================================="

                            scp \
                            -r \
                            -o StrictHostKeyChecking=yes \
                            deploy-package/. \
                            ${DEPLOY_USER}@${STAGING_HOST}:${DEPLOY_PATH}/


                            echo "================================="
                            echo "Fixing file ownership"
                            echo "================================="

                            ssh \
                            -o StrictHostKeyChecking=yes \
                            ${DEPLOY_USER}@${STAGING_HOST} \
                            "sudo chown -R ${DEPLOY_USER}:${DEPLOY_USER} ${DEPLOY_PATH}"


                            echo "================================="
                            echo "Starting application with PM2"
                            echo "================================="

                            ssh \
                            -o StrictHostKeyChecking=yes \
                            ${DEPLOY_USER}@${STAGING_HOST} \
                            "
                            cd ${DEPLOY_PATH}

                            echo 'Checking deployed files...'

                            test -f server.js
                            test -d .next

                            echo 'Removing old PM2 process if it exists...'

                            ${PM2_BIN} delete ${PM2_NAME} || true

                            echo 'Starting new PM2 process...'

                            ${PM2_BIN} start ecosystem.config.js --update-env

                            echo 'Saving PM2 configuration...'

                            ${PM2_BIN} save

                            echo 'PM2 status:'

                            ${PM2_BIN} status
                            "

                            echo "================================="
                            echo "Deployment completed"
                            echo "================================="
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 5. HEALTH CHECK
         * ========================================================
         *
         * Checks:
         *
         * 1. PM2 process is online
         * 2. Port 3000 is responding
         *
         */
        stage("Health Check") {

            steps {

                echo "================================="
                echo "Staging Health Check"
                echo "================================="

                sshagent(credentials: ["${SSH_CREDENTIAL_ID}"]) {

                    sh '''
                        set -e

                        echo "Waiting for application..."

                        sleep 10


                        echo "================================="
                        echo "Checking PM2"
                        echo "================================="

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "${PM2_BIN} status ${PM2_NAME}"


                        echo "================================="
                        echo "Checking application process"
                        echo "================================="

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "${PM2_BIN} describe ${PM2_NAME}"


                        echo "================================="
                        echo "Checking HTTP port ${PORT}"
                        echo "================================="

                        ssh \
                        -o StrictHostKeyChecking=yes \
                        ${DEPLOY_USER}@${STAGING_HOST} \
                        "curl -f http://127.0.0.1:${PORT}/"


                        echo ""
                        echo "================================="
                        echo "STAGING HEALTH CHECK PASSED"
                        echo "================================="
                    '''
                }
            }
        }
    }


    /*
     * ============================================================
     * POST ACTIONS
     * ============================================================
     */
    post {

        success {

            echo ""
            echo "================================="
            echo "JioBP STAGING DEPLOYMENT SUCCESSFUL"
            echo "================================="
            echo ""
            echo "Application : ${APP_NAME}"
            echo "PM2 Name    : ${PM2_NAME}"
            echo "Port        : ${PORT}"
            echo "Server      : ${STAGING_HOST}"
            echo "Path        : ${DEPLOY_PATH}"
            echo ""
        }


        failure {

            echo ""
            echo "================================="
            echo "STAGING DEPLOYMENT FAILED"
            echo "================================="
            echo ""
            echo "Please check the failed stage."
            echo ""
        }


        always {

            echo "Cleaning Jenkins workspace..."

            sh '''
                rm -rf deploy-package || true
                rm -f .env || true
            '''
        }
    }
}